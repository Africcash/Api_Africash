# ==============================================================================
# AfriCash Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Local Development: Copy this file to .env and adjust variables as needed.
# 2. Dokploy Deployment:
#    - When creating an Application or Compose Stack in Dokploy, copy these
#      variables into the "Environment" tab of Dokploy.
#    - Replace placeholder passwords and SECRET_KEY with strong production values.
#    - Set DEBUG=False.
#    - Add your domain to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core & Security Settings
# ------------------------------------------------------------------------------
# Generate a secret key with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=africash-insecure-dev-key-change-in-production-2026

# Set to False in production (Dokploy), True only for local debugging
DEBUG=False

# Comma-separated list of hostnames/domains this Django site can serve.
# In Dokploy, include your domain (e.g., api.yourdomain.com, backend, localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,0.0.0.0

# Comma-separated list of origins allowed to make CORS requests (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Comma-separated list of trusted origins for CSRF requests.
# REQUIRED by Django 4+ when deployed behind HTTPS in Dokploy/Traefik.
# Example: https://api.yourdomain.com,https://africash.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Production Web Server (Gunicorn)
# ------------------------------------------------------------------------------
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL / SQLite)
# - For Docker Compose / Dokploy: DB_HOST=db (service name) or your managed host
# - For Local SQLite development without Docker: leave DB_HOST empty
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=africash_db
DB_USER=africash_user
DB_PASSWORD=africash_secure_password_2026
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis Cache Settings
# - For Docker Compose / Dokploy: redis://redis:6379/1 or managed Redis URL
# - For Local standalone runs: leave REDIS_URL empty (falls back to LocMemCache)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1


# ------------------------------------------------------------------------------
# Auto-Provisioned Admin Superuser (Optional)
# If provided, docker-entrypoint.sh creates or verifies this admin on startup
# ------------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin1234
DJANGO_SUPERUSER_EMAIL=admin@africash.io

# ------------------------------------------------------------------------------
# Stellar Testnet Network Settings
# ------------------------------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ------------------------------------------------------------------------------
# Soroban Contracts (Testnet)
# ------------------------------------------------------------------------------
# USDC Stellar Asset Contract (SAC) on Testnet
USDC_ASSET_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWUQX3PUL5L5OBOFBUC
# AfriCash Escrow Contract ID (Deployed on Testnet)
ESCROW_CONTRACT_ID=CCX2P2KDVKVVMX55OPUVYESN5XD73GEJ7EWLNZWNMNLAVZIQVZH5RNRC
